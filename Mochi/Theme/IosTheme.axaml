<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="IosBg">#FFF4F6</Color>
          <Color x:Key="IosSidebar">#E6FFE3EA</Color>
          <Color x:Key="IosCard">#FFFDFD</Color>
          <Color x:Key="IosText">#3A1F2B</Color>
          <Color x:Key="IosSecondary">#A5788A</Color>
          <Color x:Key="IosSeparator">#228C3A55</Color>
          <Color x:Key="IosFill">#18C46A82</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="IosBg">#1D1216</Color>
          <Color x:Key="IosSidebar">#E62A1B20</Color>
          <Color x:Key="IosCard">#2A1C21</Color>
          <Color x:Key="IosText">#FFEFF2</Color>
          <Color x:Key="IosSecondary">#C9A0AD</Color>
          <Color x:Key="IosSeparator">#33FFB3C6</Color>
          <Color x:Key="IosFill">#3DE08AA2</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="IosBgBrush" Color="{DynamicResource IosBg}" />
      <SolidColorBrush x:Key="IosSidebarBrush" Color="{DynamicResource IosSidebar}" />
      <SolidColorBrush x:Key="IosCardBrush" Color="{DynamicResource IosCard}" />
      <SolidColorBrush x:Key="IosTextBrush" Color="{DynamicResource IosText}" />
      <SolidColorBrush x:Key="IosSecondaryBrush" Color="{DynamicResource IosSecondary}" />
      <SolidColorBrush x:Key="IosSeparatorBrush" Color="{DynamicResource IosSeparator}" />
      <SolidColorBrush x:Key="IosFillBrush" Color="{DynamicResource IosFill}" />
      <!-- Accent and radius are overwritten at runtime from Settings -->
      <SolidColorBrush x:Key="IosAccentBrush" Color="#F0456B" />
      <CornerRadius x:Key="IosRadius">18</CornerRadius>
      <FontFamily x:Key="IosFont">avares://Mochi/Assets/Fonts#Noto Sans</FontFamily>
      <FontFamily x:Key="IosDisplayFont">avares://Mochi/Assets/Fonts#Fredoka</FontFamily>
      <x:Double x:Key="IosFontSize">15</x:Double>
      <Thickness x:Key="IosNavPad">16,12</Thickness>
      <Thickness x:Key="IosCardPad">16</Thickness>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource IosBgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource IosFont}" />
    <Setter Property="FontSize" Value="{DynamicResource IosFontSize}" />
  </Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource IosTextBrush}" /></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="{DynamicResource IosDisplayFont}" /><Setter Property="FontSize" Value="36" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="TextBlock.headline"><Setter Property="FontFamily" Value="{DynamicResource IosDisplayFont}" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{DynamicResource IosSecondaryBrush}" /><Setter Property="FontSize" Value="13" /></Style>

  <Style Selector="TextBlock.failed"><Setter Property="Foreground" Value="#FF3B30" /></Style>
  <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="#34C759" /></Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource IosCardBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource IosRadius}" />
    <Setter Property="Padding" Value="{DynamicResource IosCardPad}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource IosSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IosSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{DynamicResource IosAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="100" />
    <Setter Property="Padding" Value="20,10" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IosAccentBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource IosAccentBrush}" />
  </Style>

  <!-- no scrollbars anywhere: wheel, touchpad and touch still scroll, nothing shifts when they would have appeared -->
  <Style Selector="ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- the chat input sits inside a rounded bar that draws its own outline -->
  <Style Selector="TextBox.aiinput /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="TextBox.aiinput:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="TextBox.aiinput:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>

  <!-- a tool tile in the Presets library: tap anywhere to put it in (or take it out of) the donut -->
  <Style Selector="ToggleButton.tool">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource IosCardBrush}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource IosAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource IosFillBrush}" />
  </Style>
  <Style Selector="ToggleButton.tool Border.tick"><Setter Property="Background" Value="{DynamicResource IosFillBrush}" /></Style>
  <Style Selector="ToggleButton.tool:checked Border.tick"><Setter Property="Background" Value="{DynamicResource IosAccentBrush}" /></Style>
  <Style Selector="ToggleButton.tool TextBlock.tickglyph"><Setter Property="Foreground" Value="{DynamicResource IosSecondaryBrush}" /></Style>
  <Style Selector="ToggleButton.tool:checked TextBlock.tickglyph"><Setter Property="Foreground" Value="White" /><Setter Property="Text" Value="✓" /></Style>

  <!-- a look in the Theme gallery keeps its own colours when hovered or pressed -->
  <Style Selector="Button.themetile:pointerover /template/ ContentPresenter, Button.themetile:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>

  <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="{DynamicResource IosNavPad}" />  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource IosAccentBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Path.navicon"><Setter Property="Stroke" Value="White" /></Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="#34C759" />
    <Setter Property="BorderBrush" Value="#34C759" />
  </Style>
</Styles>
