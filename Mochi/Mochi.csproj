    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="MimeKit" Version="5.0.0" />
    <PackageReference Include="MsgReader" Version="6.2.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
